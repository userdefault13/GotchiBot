{
  "//": "Copy to config/openclaw.install.json5 after clone/npm install. Replace ROOT with your GotchiBot checkout (absolute path). Or run ./scripts/openclaw-fleet.mjs sync which regenerates includes.",
  "agents": {
    "defaults": {
      "$include": "ROOT/config/openclaw.gotchi.json5"
    },
    "entries": {
      "$include": "ROOT/config/openclaw.fleet.generated.json5"
    }
  }
}
