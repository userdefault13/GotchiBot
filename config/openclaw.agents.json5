{
  "//": "Sub-agent definitions consumed by scripts/opencode-dispatch.sh and the OpenClaw gateway.",
  "defaultModel": "opencode/hy3-free",
  "orchestrator": {
    "id": "gotchi",
    "openclawAgentId": "owned-954",
    "note": "OpenClaw fleet uses cartridge hero ids (openclaw-fleet.mjs sync). gotchi is a legacy alias for the orchestrator hero.",
    "runtime": "opencode",
    "mode": "primary",
    "agentFile": ".opencode/agents/gotchi.md",
    "openclawConfig": "config/openclaw.gotchi.json5",
    "spawnScript": "scripts/gotchi-orchestrate.mjs",
    "gateScript": "scripts/wallet-gate.mjs",
    "requires": ["wallet", "cartridge", "cAavegotchi"]
  },
  "agents": {
    "sub-coder": {
      "model": "deepseek/deepseek-v4-flash",
      "role": "volume coding tasks",
      "sandbox": "workspace-only"
    },
    "sub-hard": {
      "model": "deepseek/deepseek-v4-pro",
      "role": "escalation: hard reasoning / architecture / gnarly bugs",
      "sandbox": "workspace-only"
    },
    "sub-local": {
      "model": "ollama/deepseek-r1:8b",
      "endpoint": "http://192.168.1.162:11434",
      "role": "offline/private fallback (via tunnel after migration)",
      "sandbox": "workspace-only"
    }
  },
  "rulesFile": "AGENTS.md",
  "toolPolicy": {
    "autonomousInstalls": false,
    "secretsAccess": "orchestrator-via-abra-only"
  }
}
