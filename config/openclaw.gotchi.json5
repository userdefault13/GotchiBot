{
  // GotchiBot OpenClaw agent defaults (included under agents.defaults).
  // Fleet per-hero entries: config/openclaw.fleet.generated.json5 (openclaw-fleet.mjs sync).
  // Full install: config/openclaw.install.json5
  // OpenCode Go (paid) — orchestrator primary when OPENCODE_API_KEY is in abra.
  // OpenClaw bundled plugin: opencode-go (uses OPENCODE_API_KEY).

  workspace: "~/Dev/GotchiBot",
  model: "opencode-go/glm-5.2",
  thinkingDefault: "off",

  // Desk sandbox ON — tool exec in Docker. Abra MCP is not attached on host Desk.
  sandbox: {
    mode: "all",
    backend: "docker",
    scope: "agent",
    workspaceAccess: "rw",
  },
}
