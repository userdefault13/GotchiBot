.DS_Store
sessions/*
!sessions/.gitkeep
config/openclaw/agents/*/models.json
config/openclaw/agents/*/openclaw-agent.sqlite*
KNOWLEDGE.md
sandboxes/
node_modules/

var/
.mc.menu
.venv-pdf/

# Meeting @-mention stubs: gotchi-meet.mjs writes one .opencode/agents/<HERO>.md
# per invited gotchi when a meeting opens (tagged "gotchibot-meet-agent") and
# deletes them when it closes, so tracking them means every meeting shows up as
# phantom deletions. Real agent definitions are allowlisted below — add a "!"
# line when you add one.
.opencode/agents/*
!.opencode/agents/ask.md
!.opencode/agents/build.md
!.opencode/agents/gotchi.md
!.opencode/agents/gotchiverse-map.md
!.opencode/agents/plan.md
!.opencode/agents/sandbox.md
!.opencode/agents/verse.md

# Generated, not source: aseprite-tool.mjs exports to build/ (defaultExportDir),
# tmp/ is scratch, and these are editor logs and dumped session transcripts.
build/
tmp/
.cursor/*.log
session-ses_*.md

# OpenClaw hero workspaces (config/openclaw/workspaces/<id>/): AGENTS/SOUL/IDENTITY/USER.md
# are rendered from config/openclaw/templates/ by openclaw-fleet.mjs sync and tracked so
# a diff shows what a hero was told. Skill copies and per-hero memory/state are not source.
config/openclaw/workspaces/*/skills/
config/openclaw/workspaces/*/memory/
config/openclaw/workspaces/*/openclaw-workspace-state.json
config/openclaw/workspaces/*/BOOTSTRAP.md
config/openclaw/workspaces/*/.openclaw/
