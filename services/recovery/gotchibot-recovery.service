# User unit. Enable lingering for the owning user to start before login.
# System tailscaled/sshd units must be enabled separately; a user unit cannot order them.
[Unit]
Description=GotchiBot Tailscale hub/desk recovery

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment="PATH=@PATH@"
ExecStart=@NODE@ @REPO@/scripts/hub-desk-recovery.mjs run
Restart=always
RestartSec=30
TimeoutStopSec=20

[Install]
WantedBy=default.target
