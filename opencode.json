  "agent": {
    "gotchi": {
      "order": 1
    },
    "sub": {
      "order": 2
    },
    "verse": {
      "order": 3
    },
    "plan": {
      "order": 4
    },
    "build": {
      "order": 5
    },
    "ask": {
      "order": 6
    }
  },
  "mcp": {
    "abracadabra": {
      "type": "local",
      "command": [
        "abra",
        "mcp"
      ],
      "enabled": true
    },
    "aarcade-cartridge-schema": {
      "type": "local",
      "command": [
        "./scripts/mcp/aarcade-cartridge-schema.sh"
      ],
      "enabled": true,
      "environment": {
        "AARCADE_CARTRIDGE_WRITE_BASE": "http://127.0.0.1:8791",
        "AARCADE_LORE_API_BASE": "http://127.0.0.1:3010",
        "AARCADE_CARTRIDGE_SIM_ON_LORE": "disabled"
      }
    },
    "aarcade-hackathon-ideas": {
      "type": "local",
      "command": [
        "./scripts/mcp/aarcade-hackathon-ideas.sh"
      ],
      "enabled": true
    },
    "cron402": {
      "type": "local",
      "command": [
        "./scripts/mcp/cron402.sh"
      ],
      "enabled": true
    },
    "base-mcp": {
      "type": "remote",
      "url": "https://mcp.base.org",
      "enabled": true
    },
    "blockscout": {
      "type": "remote",
      "url": "https://mcp.blockscout.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "./scripts/mcp/github.sh"
      ],
      "enabled": true
    },
    "gotchibot-claude": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-claude.sh"
      ],
      "enabled": true,
      "timeout": 360000
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "./scripts/*.mjs*": "allow",
      "./scripts/cursor-cli.mjs*": "allow",
      "node ./scripts/cursor-cli.mjs*": "allow",
      "node scripts/cursor-cli.mjs*": "allow",
      "cursor-agent *": "allow",
      "$HOME/.local/bin/cursor-agent *": "allow",
      "./scripts/*.sh*": "allow",
      "./scripts/gotchibot*": "allow",
      "./scripts/avatar-*": "allow",
      "node ./scripts/*.mjs*": "allow",
      "node scripts/*.mjs*": "allow",
      "abra run gotchibot -- *": "allow",
      "./scripts/wallet-roster.mjs*": "allow",
      "node scripts/wallet-roster.mjs*": "allow",
      "node ./scripts/wallet-roster.mjs*": "allow",
      "abra run gotchibot -- node scripts/wallet-roster.mjs*": "allow",
      "abra run gotchibot -- ./scripts/wallet-roster.mjs*": "allow",
      "./scripts/identity.mjs*": "allow",
      "node scripts/identity.mjs*": "allow",
      "node ./scripts/identity.mjs*": "allow",
      "abra run gotchibot -- node scripts/identity.mjs*": "allow",
      "*thegraph*": "allow",
      "curl *subgraph*": "allow",
      "curl *graph*": "allow",
      "curl *127.0.0.1*": "allow",
      "curl *localhost*": "allow",
      "curl *aarcadeghst.com*": "allow",
      "curl *cartridge.aarcadeghst.com*": "allow",
      "curl *subgraph.aarcadeghst.com*": "allow",
      "*blockscout*": "deny"
    }
  }
}
