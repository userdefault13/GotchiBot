{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k3",
  "small_model": "opencode/big-pickle",
  "default_agent": "gotchi",
  "provider": {
    "openclaw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gotchi (OpenClaw orchestrator)",
      "options": {
        "baseURL": "{env:GOTCHIBOT_OPENCLAW_HTTP_V1}",
        "apiKey": "{env:OPENCLAW_GATEWAY_TOKEN}",
        "headers": {
          "x-openclaw-session-key": "{env:GOTCHIBOT_OPENCLAW_SESSION_KEY}"
        }
      },
      "models": {
        "orchestrator": {
          "name": "Orchestrator (iMac OpenClaw)",
          "modelID": "openclaw/default"
        }
      }
    },
    "claudemode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "@claudemode (Hub VS Code Claude)",
      "options": {
        "baseURL": "http://127.0.0.1:45680/v1",
        "apiKey": "local"
      },
      "models": {
        "@claudemode": {
          "name": "@claudemode",
          "tool_call": false
        },
        "claudemode": {
          "name": "claudemode",
          "tool_call": false
        }
      }
    }
  },
  "agent": {
    "gotchi": {
      "order": 1
    },
    "sandbox": {
      "order": 2
    },
    "verse": {
      "order": 3
    },
    "plan": {
      "order": 4
    },
    "build": {
      "order": 5
    },
    "ask": {
      "order": 6
    }
  },
  "mcp": {
    "abracadabra": {
      "type": "local",
      "command": [
        "abra",
        "mcp"
      ],
      "enabled": false,
      "$comment": "Abra MCP is sandbox-only (Docker sub-agent). Disabled on host OpenCode/Desk."
    },
    "aarcade-cartridge-schema": {
      "type": "local",
      "command": [
        "./scripts/mcp/aarcade-cartridge-schema.sh"
      ],
      "enabled": true,
      "environment": {
        "AARCADE_CARTRIDGE_WRITE_BASE": "http://127.0.0.1:8791",
        "AARCADE_LORE_API_BASE": "http://127.0.0.1:3010",
        "AARCADE_CARTRIDGE_SIM_ON_LORE": "disabled"
      }
    },
    "aarcade-hackathon-ideas": {
      "type": "local",
      "command": [
        "./scripts/mcp/aarcade-hackathon-ideas.sh"
      ],
      "enabled": true
    },
    "cron402": {
      "type": "local",
      "command": [
        "./scripts/mcp/cron402.sh"
      ],
      "enabled": true
    },
    "base-mcp": {
      "type": "remote",
      "url": "https://mcp.base.org",
      "enabled": true
    },
    "blockscout": {
      "type": "remote",
      "url": "https://mcp.blockscout.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "./scripts/mcp/github.sh"
      ],
      "enabled": true
    },
    "gotchibot-claude": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-claude.sh"
      ],
      "enabled": true,
      "timeout": 360000
    },
    "gotchibot-hub": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-hub.sh"
      ],
      "enabled": true,
      "timeout": 300000
    },
    "gotchibot-synergy": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-synergy.sh"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "gotchibot-pdf": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-pdf.sh"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "gotchibot-meet": {
      "type": "local",
      "command": [
        "./scripts/mcp/gotchibot-meet.sh"
      ],
      "enabled": true,
      "timeout": 600000
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "./scripts/*.mjs*": "allow",
      "./scripts/cursor-cli.mjs*": "allow",
      "node ./scripts/cursor-cli.mjs*": "allow",
      "node scripts/cursor-cli.mjs*": "allow",
      "cursor-agent *": "allow",
      "$HOME/.local/bin/cursor-agent *": "allow",
      "./scripts/*.sh*": "allow",
      "./scripts/gotchibot*": "allow",
      "./scripts/avatar-*": "allow",
      "node ./scripts/*.mjs*": "allow",
      "node scripts/*.mjs*": "allow",
      "abra *": "deny",
      "abra run *": "deny",
      "./scripts/wallet-roster.mjs*": "allow",
      "node scripts/wallet-roster.mjs*": "allow",
      "node ./scripts/wallet-roster.mjs*": "allow",
      "./scripts/identity.mjs*": "allow",
      "node scripts/identity.mjs*": "allow",
      "node ./scripts/identity.mjs*": "allow",
      "*thegraph*": "allow",
      "curl *subgraph*": "allow",
      "curl *graph*": "allow",
      "curl *127.0.0.1*": "allow",
      "curl *localhost*": "allow",
      "curl *aarcadeghst.com*": "allow",
      "curl *cartridge.aarcadeghst.com*": "allow",
      "curl *subgraph.aarcadeghst.com*": "allow",
      "*blockscout*": "deny"
    }
  }
}
