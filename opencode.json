    "openclaw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gotchi (OpenClaw orchestrator)",
      "options": {
        "baseURL": "{env:GOTCHIBOT_OPENCLAW_HTTP_V1}",
        "apiKey": "{env:OPENCLAW_GATEWAY_TOKEN}",
        "headers": {
          "x-openclaw-session-key": "{env:GOTCHIBOT_OPENCLAW_SESSION_KEY}"
        }
      },
      "models": {
        "orchestrator": {
          "name": "Orchestrator (iMac OpenClaw)",
          "modelID": "openclaw/default"
        }
      }
    },
    "claudemode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "@claudemode (Hub VS Code Claude)",
      "options": {
        "baseURL": "http://127.0.0.1:45680/v1",
        "apiKey": "local"
      },
      "models": {
        "@claudemode": {
          "name": "@claudemode",
          "tool_call": false
        },
        "claudemode": {
          "name": "claudemode",
          "tool_call": false
        }
      }
    }
