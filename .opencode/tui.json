{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "gotchi",
  "mouse": true,
  "scroll_speed": 4,
  "scroll_acceleration": {
    "enabled": true
  },
  "keybinds": {
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab",
    "agent_list": "<leader>a,ctrl+p",
    "sidebar_toggle": "ctrl+shift+g,<leader>b",
    "prompt.autocomplete.complete": "ctrl+space",
    "prompt.autocomplete.select": "return",
    "messages_copy": "<leader>y",
    "input_paste": {
      "key": "ctrl+v",
      "preventDefault": false
    },
    "input_select_all": "super+a"
  },
  "plugin": [
    "./tui-plugins/gotchi-thought-tts.ts",
    "./tui-plugins/gotchi-sidebar-hide.ts",
    "./tui-plugins/gotchi-spawn.ts",
    "./tui-plugins/gotchi-queue-multitask.ts"
  ]
}
