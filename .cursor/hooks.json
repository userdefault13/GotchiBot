{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-bash.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard-write.mjs",
        "matcher": "Write|Delete",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/check-syntax.mjs",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/check-syntax.mjs",
        "matcher": "Write",
        "timeout": 30
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-brief.mjs",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/contexter-precompact.mjs",
        "timeout": 25
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/ralph-capture.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/ralph-stop.mjs",
        "timeout": 20,
        "loop_limit": null
      },
      {
        "command": "node .cursor/hooks/contexter-restore.mjs",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
