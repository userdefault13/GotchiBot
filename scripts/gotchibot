    # Ensure CLAUDE.md + .claude/agents/gotchibot-proxy.md (Hub Claude proxy identity).
    abra_or_node "$ROOT/scripts/claude-pane-init.mjs" "$@"
    ;;
  claudemode-proxy|claude-proxy)
    # Optional OpenAI proxy if someone still uses /model @claudemode — prefer claude-ask.
    if [ "${1:-}" = "--check" ]; then
      curl -sf --max-time 2 http://127.0.0.1:45680/health && exit 0
      echo "claudemode proxy down on :45680 (optional; prefer gotchibot claude-ask)" >&2
      exit 1
    fi
    exec node "$ROOT/scripts/claudemode-proxy.mjs" "$@"
    ;;
  wisp-proxy|wisp_proxy)
    # OpenAI proxy for /model wisp/gotchi (soul chat; desk stays on agent=gotchi).
    if [ "${1:-}" = "--check" ]; then
      curl -sf --max-time 2 http://127.0.0.1:45682/health && exit 0
      echo "wisp proxy down on :45682 — start: gotchibot wisp-proxy" >&2
      exit 1
    fi
    exec node "$ROOT/scripts/wisp-proxy.mjs" "$@"
    ;;
  tunnel)
    sub="${1:-status}"
    shift || true
    case "$sub" in
      status) abra_or_node "$ROOT/scripts/tunnel-health.mjs" --remote "$@" ;;
      restart) abra_or_node "$ROOT/scripts/remote-tunnel-restart.mjs" "$@" ;;
      *) echo "usage: gotchibot tunnel status|restart" >&2; exit 2 ;;
    esac
    ;;
  menubar) cmd_menubar "$@" ;;
  mesh) exec node "$ROOT/scripts/mesh-status.mjs" "$@" ;;
  trader)
    if [ "${1:-}" = "schedule" ]; then shift; exec node "$ROOT/scripts/trader-schedule.mjs" "$@"; fi
    exec node "$ROOT/scripts/gotchi-trader-desk.mjs" "$@" ;;
  link-cube|summon|hatch|resummon|rehatch)
    # prof.link-cube: intake → design → confirm → summon(portal) OR resummon(existing)
    # → wire role/playbook/SOUL/IDENTITY + fleet sync. Never auto-mints.
    # Top-level summon|hatch|resummon|rehatch inject the subcommand as argv[0].
    case "$cmd" in
      summon|hatch|resummon|rehatch) set -- "$cmd" "$@" ;;
    esac
    exec node "$ROOT/scripts/prof-link-cube.mjs" "$@" ;;
  moltbook)
    case "${1:-}" in
      schedule) shift; exec node "$ROOT/scripts/moltbook-schedule.mjs" "$@" ;;
      reply) shift; exec node "$ROOT/scripts/moltbook-reply.mjs" "$@" ;;
