    exec node "$ROOT/scripts/tui-policy.mjs" "$@"
    ;;
  project)
    exec node "$ROOT/scripts/project-intake.mjs" "$@"
    ;;
  layout-check|layout-smoke) exec "$ROOT/scripts/layout-smoke.sh" "$@" ;;
  orch) cmd_orch "$@" ;;
  openclaw) cmd_openclaw "$@" ;;
  delegate) cmd_delegate "$@" ;;
  hero-state|hero-agent-state)
    abra_or_node "$ROOT/scripts/hero-agent-state.mjs" "$@"
    ;;
  status) exec "$DISPATCH" status "$@" ;;
  wait) exec "$DISPATCH" wait "$@" ;;
  output) exec "$DISPATCH" output "$@" ;;
