  project-mailbox|proj-mailbox|mailbox) cmd_project_mailbox "$@" ;;
  inbox|bot-inbox) cmd_inbox "$@" ;;
  graph|graph-state) cmd_graph "$@" ;;
  jev|typesafe|systemone) cmd_jev "$@" ;;
  meet) cmd_meet "$@" ;;
