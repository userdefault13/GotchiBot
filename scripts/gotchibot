  agents) cmd_agents "$@" ;;
  switch) cmd_switch "$@" ;;
  focus) cmd_focus "$@" ;;
  cockpit|onboarding) cmd_cockpit "$@" ;;
  kanban) cmd_kanban "$@" ;;
