  requests) exec "$DISPATCH" requests ;;
  avatar)
    if [ $# -eq 0 ]; then
      exec "$ROOT/scripts/orchestrator-layout.sh" show-avatar
    fi
    [ $# -eq 1 ] || usage
    cmd_avatar "$1"
    ;;
  init)
    if command -v abra >/dev/null 2>&1 && [ -z "${SSH_PRIVATE_KEY:-}" ]; then
      exec abra run gotchibot -- node "$ROOT/scripts/init.mjs"
    else
      exec node "$ROOT/scripts/init.mjs"
    fi
    ;;
  onboard) exec node "$ROOT/scripts/solo-onboard.mjs" "$@" ;;
  setup) exec node "$ROOT/scripts/topology.mjs" setup "$@" ;;
  topology) exec node "$ROOT/scripts/topology.mjs" "$@" ;;
  doctor)
    if command -v abra >/dev/null 2>&1 && [ -z "${SSH_PRIVATE_KEY:-}" ]; then
      exec abra run gotchibot -- node "$ROOT/scripts/doctor.mjs" "$@"
    else
      exec node "$ROOT/scripts/doctor.mjs" "$@"
    fi
    ;;
  mint-cart)
    exec node "$ROOT/scripts/cartridge-mint-sepolia.mjs" "$@"
    ;;
