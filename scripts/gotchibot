    exec node "$ROOT/scripts/template-pack.mjs" "$@"
    ;;
  pack-wearable|pack-wearables|wearable-pack)
    exec node "$ROOT/scripts/pack-wearable.mjs" "$@"
    ;;
  sidebar) exec "$ROOT/scripts/orchestrator-layout.sh" sidebar ;;
  files-max|explorer) exec "$ROOT/scripts/orchestrator-layout.sh" files-max ;;
  avatar-max) exec "$ROOT/scripts/orchestrator-layout.sh" avatar-max ;;
  *) usage ;;
esac
