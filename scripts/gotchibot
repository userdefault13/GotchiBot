  exec node "$ROOT/scripts/identity.mjs" "$@"
}

cmd_remote_setup() {
  cat <<'EOF'
GotchiBot — Fleet / own Hub (Tailscale)

  Desk MBP ──Tailscale──→ Hub Mac (OpenClaw + gotchibot-api + BYO Mongo)
  Arcade (www) holds install token + hub.tailscaleHost + chatStore.kind only
  Chat bodies live on YOUR Hub Mongo (local Docker or Atlas) — not Arcade

1) Register install:  ./scripts/gotchibot infra register
2) Enable Hub:        ./scripts/gotchibot hub enable <MagicDNS|100.x>
                      → writes sessions/.hub.json (remote-lib reads it)
3) On the Hub:        ./scripts/gotchibot hub install
                      → gotchibot-api + local Mongo + tailscale serve (tailnet only), prints a pairing code
4) On each desk:      ./scripts/gotchibot hub join <MagicDNS> <code>
                      → writes sessions/.hub.json with this desk's token
5) Vault:             abra set gotchibot REMOTE_USER + SSH key
6) From Desk:
   abra run gotchibot -- ./scripts/gotchibot remote-push
   abra run gotchibot -- ./scripts/gotchibot attach

Chat sync (orch thread → your Hub; desk token, not install token):
   ./scripts/gotchibot chats push --text "…"
   ./scripts/gotchibot chats pull

See docs/GOTCHIBOT-HUB.md + docs/GOTCHIBOT-API.md.
EOF
}

abra_or_node() {
  if [ -n "${SSH_PRIVATE_KEY:-}" ] && [ -n "${REMOTE_HOST:-}" ]; then
    exec node "$@"
  fi
  if command -v abra >/dev/null 2>&1; then
    exec abra run gotchibot -- node "$@"
  fi
  echo "need abra (or SSH_PRIVATE_KEY+REMOTE_HOST+REMOTE_USER in env)" >&2
  exit 1
}

cmd_remote() {
  # Strip optional leading --
  if [ "${1:-}" = "--" ]; then shift; fi
  [ $# -ge 1 ] || { echo "usage: gotchibot remote -- <cmd…>" >&2; exit 2; }
  abra_or_node "$ROOT/scripts/remote-ssh.mjs" -- "$@"
}

cmd_remote_sync() {
  abra_or_node "$ROOT/scripts/remote-sync.mjs"
}

cmd_attach() {
  maybe_update_check
  if [ -n "${OPENCODE_SERVER_PASSWORD:-}" ] && [ -n "${REMOTE_HOST:-}${GOTCHIBOT_OPENCODE_URL:-}" ]; then
    exec node "$ROOT/scripts/attach-imac.mjs" "$@"
  fi
  if command -v abra >/dev/null 2>&1; then
    exec abra run gotchibot -- node "$ROOT/scripts/attach-imac.mjs" "$@"
  fi
  echo "need abra (or OPENCODE_SERVER_PASSWORD + REMOTE_HOST in env)" >&2
  exit 1
}

