  handoff) cmd_handoff "$@" ;;
  passoff) exec node "$ROOT/scripts/passoff.mjs" "$@" ;;
  wake|desk-wake) exec node "$ROOT/scripts/desk-wake.mjs" "$@" ;;
  pstack)
    if [ "${1:-}" = "dossier" ]; then
      shift
