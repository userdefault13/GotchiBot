cmd_meet() {
  if command -v abra >/dev/null 2>&1; then
    exec abra run gotchibot -- node "$ROOT/scripts/gotchi-meet.mjs" "$@"
  fi
  exec node "$ROOT/scripts/gotchi-meet.mjs" "$@"
}

cmd_openclaw() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    install)
      exec "$ROOT/scripts/openclaw-cli-install.sh" "$@"
      ;;
    point)
      abra_or_node "$ROOT/scripts/openclaw-fleet.mjs" point "$@"
      ;;
    "")
      echo "usage: gotchibot openclaw install|sync|list|status|chat …" >&2
      exit 2
      ;;
    *)
      abra_or_node "$ROOT/scripts/openclaw-fleet.mjs" "$sub" "$@"
      ;;
  esac
}

cmd_delegate() {
  if command -v abra >/dev/null 2>&1; then
    exec abra run gotchibot -- node "$ROOT/scripts/delegate-pick.mjs" "$@"
  fi
  exec node "$ROOT/scripts/delegate-pick.mjs" "$@"
}

cmd_qr() {
  if [ -n "${OPENCODE_SERVER_PASSWORD:-}" ]; then
    exec node "$ROOT/scripts/iphone-qr.mjs" "$@"
  fi
  if command -v abra >/dev/null 2>&1; then
    exec abra run gotchibot -- node "$ROOT/scripts/iphone-qr.mjs" "$@"
  fi
  echo "need abra (or OPENCODE_SERVER_PASSWORD in env)" >&2
  exit 1
}

cmd_menubar() {
  local sub="${1:-}"
  local plugin_src="$ROOT/scripts/menubar-agents.sh"
  local plugins_dir="${GOTCHIBOT_SWIFTBAR_DIR:-$HOME/Library/Application Support/SwiftBar}"
  local dest="$plugins_dir/GotchiBot Agents.5s.sh"

  case "$sub" in
    preview|"")
      exec "$plugin_src"
      ;;
    path)
      printf '%s\n' "$plugins_dir"
      ;;
    open)
      mkdir -p "$plugins_dir"
      open "$plugins_dir"
      printf '%s\n' "$plugins_dir"
      ;;
    install)
      if [ ! -d "/Applications/SwiftBar.app" ] && [ ! -d "$HOME/Applications/SwiftBar.app" ]; then
        echo "SwiftBar not found. Install it first (needs your approval):" >&2
        echo "  brew install --cask swiftbar" >&2
        echo "Then open SwiftBar once and re-run: gotchibot menubar install" >&2
        exit 1
      fi
      mkdir -p "$plugins_dir"
      ln -sfn "$plugin_src" "$dest"
      chmod +x "$plugin_src"
      open "$plugins_dir" 2>/dev/null || true
      open -g -a SwiftBar 2>/dev/null || true
      echo "linked: $dest"
      echo ""
      echo "If SwiftBar asks for a plugins folder (Documents is blocked):"
      echo "  1. Click Choose New Location"
      echo "  2. Pick: $plugins_dir"
      echo "     (or run: ./scripts/gotchibot menubar open)"
      echo "  3. Confirm — menu bar should show 👻N (refreshes every 5s)"
      ;;
    uninstall)
      rm -f "$dest"
      echo "removed: $dest"
      ;;
    *)
      echo "usage: gotchibot menubar install|uninstall|preview|path|open" >&2
      exit 2
      ;;
  esac
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  tmux) cmd_tmux ;;
  chat) cmd_chat "$@" ;;
  spawn) cmd_spawn "$@" ;;
  new) "$DISPATCH" new "$@" ;;
  list) exec "$DISPATCH" list ;;
  agents) cmd_agents "$@" ;;
  switch) cmd_switch "$@" ;;
  focus) cmd_focus "$@" ;;
  cockpit|onboarding) cmd_cockpit "$@" ;;
  meet) cmd_meet "$@" ;;
  model-policy|models-policy)
    exec node "$ROOT/scripts/model-policy.mjs" "$@"
    ;;
  tui-policy|tab-policy)
    exec node "$ROOT/scripts/tui-policy.mjs" "$@"
    ;;
  project)
    exec node "$ROOT/scripts/project-intake.mjs" "$@"
    ;;
  layout-check|layout-smoke) exec "$ROOT/scripts/layout-smoke.sh" "$@" ;;
  orch) cmd_orch "$@" ;;
  openclaw) cmd_openclaw "$@" ;;
  delegate) cmd_delegate "$@" ;;
  hero-state|hero-agent-state)
    abra_or_node "$ROOT/scripts/hero-agent-state.mjs" "$@"
    ;;
  status) exec "$DISPATCH" status "$@" ;;
  wait) exec "$DISPATCH" wait "$@" ;;
  output) exec "$DISPATCH" output "$@" ;;
  requests) exec "$DISPATCH" requests ;;
  avatar)
    if [ $# -eq 0 ]; then
      exec "$ROOT/scripts/orchestrator-layout.sh" show-avatar
    fi
    [ $# -eq 1 ] || usage
    cmd_avatar "$1"
    ;;
  init)
    if command -v abra >/dev/null 2>&1 && [ -z "${SSH_PRIVATE_KEY:-}" ]; then
      exec abra run gotchibot -- node "$ROOT/scripts/init.mjs"
    else
      exec node "$ROOT/scripts/init.mjs"
    fi
    ;;
  onboard) exec node "$ROOT/scripts/solo-onboard.mjs" "$@" ;;
  setup) exec node "$ROOT/scripts/topology.mjs" setup "$@" ;;
  topology) exec node "$ROOT/scripts/topology.mjs" "$@" ;;
  doctor)
    if command -v abra >/dev/null 2>&1 && [ -z "${SSH_PRIVATE_KEY:-}" ]; then
      exec abra run gotchibot -- node "$ROOT/scripts/doctor.mjs" "$@"
    else
      exec node "$ROOT/scripts/doctor.mjs" "$@"
    fi
    ;;
  wsl) exec node "$ROOT/scripts/wsl-setup.mjs" "$@" ;;
  update) exec node "$ROOT/scripts/update-check.mjs" "$@" ;;
  infra)
    case "${1:-}" in
      register|status) exec node "$ROOT/scripts/infra-token.mjs" "$1" "${@:2}" ;;
      *) echo "usage: gotchibot infra register|status" >&2; exit 2 ;;
    esac
    ;;
  infra-usage|usage-report) exec node "$ROOT/scripts/infra-usage-report.mjs" "$@" ;;
  aseprite) exec node "$ROOT/scripts/aseprite-tool.mjs" "$@" ;;
  pdf|pymupdf) exec node "$ROOT/scripts/pdf-tool.mjs" "$@" ;;
  connect) exec node "$ROOT/scripts/wallet-connect.mjs" ;;
  wallet) cmd_wallet ;;
  roster) cmd_roster "$@" ;;
  handoff) cmd_handoff "$@" ;;
  ask) cmd_ask "$@" ;;
  multitask) cmd_multitask "$@" ;;
  mode) cmd_mode "$@" ;;
  gotchi-mode) cmd_gotchi_mode "$@" ;;
  cursor) cmd_cursor "$@" ;;
  checkpoint) cmd_checkpoint "$@" ;;
  reset) cmd_reset "$@" ;;
  onboarding) exec node "$ROOT/scripts/onboarding-gate.mjs" ;;
  tts) cmd_tts "$@" ;;
  identity) cmd_identity "$@" ;;
  attach) cmd_attach "$@" ;;
  qr) cmd_qr "$@" ;;
  remote) cmd_remote "$@" ;;

  remote-sync) cmd_remote_sync "$@" ;;
  remote-push) abra_or_node "$ROOT/scripts/remote-push.mjs" ;;
  remote-openclaw) abra_or_node "$ROOT/scripts/remote-openclaw-deploy.mjs" "$@" ;;
  remote-serve) abra_or_node "$ROOT/scripts/remote-serve.mjs" ;;
  comms-cron-deploy) abra_or_node "$ROOT/scripts/comms-agent-cron-deploy.mjs" ;;
  commsies-imac-deploy) abra_or_node "$ROOT/scripts/commsies-imac-deploy.mjs" ;;
  remote-setup) cmd_remote_setup ;;
  remote-status) abra_or_node "$ROOT/scripts/remote-status.mjs" ;;
  hub)
    # Hub SOP: status (default) or restart-gateway / doctor / vscode / bridge / tunnel
    sub="${1:-status}"
    case "$sub" in
      ""|status|--json|--infra|--live|-h|--help)
        abra_or_node "$ROOT/scripts/hub-status.mjs" "$@"
        ;;
      restart-gateway|restart|doctor|vscode-open|bridge-check|bridge-ensure|ensure-bridge|bridge-info|claude-pane-init|tunnel-restart)
        shift || true
        abra_or_node "$ROOT/scripts/hub-ops.mjs" "$sub" "$@"
        ;;
      monitor|hubmon|agent-monitor)
        shift || true
        if [ $# -eq 0 ]; then
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" open
        elif [[ "${1:-}" == --* ]]; then
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" open "$@"
        else
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" "$@"
        fi
        ;;
      dashboard)
        shift || true
        exec node "$ROOT/scripts/hub-agent-monitor.mjs" dashboard "$@"
        ;;
      *)
        # pass-through flags to hub-status (e.g. hub --json)
        abra_or_node "$ROOT/scripts/hub-status.mjs" "$@"
        ;;
    esac
    ;;
  hubmon|agent-monitor)
    if [ $# -eq 0 ]; then
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" open
    elif [[ "${1:-}" == --* ]]; then
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" open "$@"
    else
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" "$@"
    fi
    ;;
  hub-dashboard)
    exec node "$ROOT/scripts/hub-agent-monitor.mjs" dashboard "$@"
    ;;
  hub-ops)
    abra_or_node "$ROOT/scripts/hub-ops.mjs" "$@"
    ;;
  bridge-prompt|bridge)
    # Desk → Hub VS Code Claude → Desk receiver :45679 (needs abra for SSH).
    abra_or_node "$ROOT/scripts/bridge-prompt.mjs" "$@"
    ;;
  vscode-open|vscode-ensure|hub-vscode-open)
    # Open/focus Hub VS Code on GotchiBot so gotchibot-bridge can serve Claude.
    abra_or_node "$ROOT/scripts/hub-vscode-open.mjs" "$@"
    ;;
  bridge-ensure|ensure-bridge)
    # One-shot Hub Claude bridge recovery (receiver + bridge + restart).
    abra_or_node "$ROOT/scripts/hub-bridge-ensure.mjs" "$@"
    ;;
  claude-ask|claudemode-ask)
    # Orchestrator tool: stay on big-pickle; print Hub Claude reply only (sync).
    abra_or_node "$ROOT/scripts/claudemode-ask.mjs" "$@"
    ;;
  claude-submit|claudemode-submit)
    # Async: return pending id immediately (no wait/poll).
    abra_or_node "$ROOT/scripts/claudemode-submit.mjs" "$@"
    ;;
  claude-collect|claudemode-collect)
    exec node "$ROOT/scripts/claude-jobs.mjs" collect "$@"
    ;;
  claude-jobs|claudemode-jobs)
    exec node "$ROOT/scripts/claude-jobs.mjs" list "$@"
    ;;
  claude-pane-init|claude-proxy-init)
    # Ensure CLAUDE.md + .claude/agents/gotchibot-proxy.md (Hub Claude proxy identity).
    abra_or_node "$ROOT/scripts/claude-pane-init.mjs" "$@"
    ;;
  claudemode-proxy|claude-proxy)
    # Optional OpenAI proxy if someone still uses /model @claudemode — prefer claude-ask.
    if [ "${1:-}" = "--check" ]; then
      curl -sf --max-time 2 http://127.0.0.1:45680/health && exit 0
      echo "claudemode proxy down on :45680 (optional; prefer gotchibot claude-ask)" >&2
      exit 1
    fi
    exec node "$ROOT/scripts/claudemode-proxy.mjs" "$@"
    ;;
  tunnel)
    sub="${1:-status}"
    shift || true
    case "$sub" in
      status) abra_or_node "$ROOT/scripts/tunnel-health.mjs" --remote "$@" ;;
      restart) abra_or_node "$ROOT/scripts/remote-tunnel-restart.mjs" "$@" ;;
      *) echo "usage: gotchibot tunnel status|restart" >&2; exit 2 ;;
    esac
    ;;
  menubar) cmd_menubar "$@" ;;
  mesh) exec node "$ROOT/scripts/mesh-status.mjs" "$@" ;;
  trader) exec node "$ROOT/scripts/gotchi-trader-desk.mjs" "$@" ;;
  model) abra_or_node "$ROOT/scripts/model-auto.mjs" "$@" ;;
  sidebar) exec "$ROOT/scripts/orchestrator-layout.sh" sidebar ;;
  files-max|explorer) exec "$ROOT/scripts/orchestrator-layout.sh" files-max ;;
  avatar-max) exec "$ROOT/scripts/orchestrator-layout.sh" avatar-max ;;
  *) usage ;;
esac
