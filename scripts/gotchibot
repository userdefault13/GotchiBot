  qr) cmd_qr "$@" ;;
  remote) cmd_remote "$@" ;;

  remote-sync) cmd_remote_sync "$@" ;;
  remote-push) abra_or_node "$ROOT/scripts/remote-push.mjs" ;;
  remote-openclaw) abra_or_node "$ROOT/scripts/remote-openclaw-deploy.mjs" "$@" ;;
  remote-serve) abra_or_node "$ROOT/scripts/remote-serve.mjs" ;;
  comms)
    sub="${1:-run}"; shift || true
    case "$sub" in
      run) abra_or_node "$ROOT/scripts/comms-claude-cycle.mjs" --host imac "$@" ;;
      dry-run) abra_or_node "$ROOT/scripts/comms-claude-cycle.mjs" --host imac --dry-run "$@" ;;
      status) abra_or_node "$ROOT/scripts/comms-claude-cycle.mjs" --host imac --status "$@" ;;
      schedule)
        case "${1:-status}" in
          status) abra_or_node "$ROOT/scripts/comms-agent-cron-deploy.mjs" --status ;;
          install) abra_or_node "$ROOT/scripts/comms-agent-cron-deploy.mjs" ;;
          *) echo "usage: gotchibot comms schedule status|install" >&2; exit 2 ;;
        esac ;;
      *) echo "usage: gotchibot comms run|dry-run|status|schedule [--range repo:before..after] [--repo X]" >&2; exit 2 ;;
    esac ;;
  comms-cron-deploy) abra_or_node "$ROOT/scripts/comms-agent-cron-deploy.mjs" ;;
  commsies-imac-deploy) abra_or_node "$ROOT/scripts/commsies-imac-deploy.mjs" ;;
  remote-setup) cmd_remote_setup ;;
  remote-status) abra_or_node "$ROOT/scripts/remote-status.mjs" ;;
  hub)
    # Arcade pin (enable/pin/chat-store) vs Hub SOP (status/ops/monitor)
    sub="${1:-status}"
    case "$sub" in
      pair|join|desks|revoke)
        exec node "$ROOT/scripts/hub-pair.mjs" "$@"
        ;;
      install|uninstall)
        exec node "$ROOT/scripts/hub-install.mjs" "$@"
        ;;
      enable|pin|chat-store|chatstore|arcade-status)
        exec node "$ROOT/scripts/hub.mjs" "$@"
        ;;
      ""|status|--json|--infra|--live|-h|--help)
        abra_or_node "$ROOT/scripts/hub-status.mjs" "$@"
        ;;
      restart-gateway|restart|doctor|vscode-open|bridge-check|bridge-ensure|ensure-bridge|bridge-info|claude-pane-init|tunnel-restart)
        shift || true
        abra_or_node "$ROOT/scripts/hub-ops.mjs" "$sub" "$@"
        ;;
      roster|bots|who)
        shift || true
        exec node "$ROOT/scripts/hub-roster.mjs" "$@"
        ;;
      monitor|hubmon|agent-monitor)
        shift || true
        if [ $# -eq 0 ]; then
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" open
        elif [[ "${1:-}" == --* ]]; then
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" open "$@"
        else
          exec node "$ROOT/scripts/hub-agent-monitor.mjs" "$@"
        fi
        ;;
      dashboard)
        shift || true
        exec node "$ROOT/scripts/hub-agent-monitor.mjs" dashboard "$@"
        ;;
      *)
        # pass-through flags to hub-status (e.g. hub --json)
        abra_or_node "$ROOT/scripts/hub-status.mjs" "$@"
        ;;
    esac
    ;;
  hubmon|agent-monitor)
    if [ $# -eq 0 ]; then
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" open
    elif [[ "${1:-}" == --* ]]; then
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" open "$@"
    else
      exec node "$ROOT/scripts/hub-agent-monitor.mjs" "$@"
    fi
    ;;
  hub-dashboard)
    exec node "$ROOT/scripts/hub-agent-monitor.mjs" dashboard "$@"
    ;;
  hub-ops)
    abra_or_node "$ROOT/scripts/hub-ops.mjs" "$@"
    ;;
  bridge-prompt|bridge)
    # Desk → Hub VS Code Claude → Desk receiver :45679 (needs abra for SSH).
    abra_or_node "$ROOT/scripts/bridge-prompt.mjs" "$@"
    ;;
  vscode-open|vscode-ensure|hub-vscode-open)
    # Open/focus Hub VS Code on GotchiBot so gotchibot-bridge can serve Claude.
    abra_or_node "$ROOT/scripts/hub-vscode-open.mjs" "$@"
    ;;
  bridge-ensure|ensure-bridge)
    # One-shot Hub Claude bridge recovery (receiver + bridge + restart).
    abra_or_node "$ROOT/scripts/hub-bridge-ensure.mjs" "$@"
    ;;
  claude-ask|claudemode-ask)
    # Orchestrator tool: stay on big-pickle; print Hub Claude reply only (sync).
    abra_or_node "$ROOT/scripts/claudemode-ask.mjs" "$@"
    ;;
  claude-submit|claudemode-submit)
    # Async: return pending id immediately (no wait/poll).
    abra_or_node "$ROOT/scripts/claudemode-submit.mjs" "$@"
    ;;
  claude-collect|claudemode-collect)
    exec node "$ROOT/scripts/claude-jobs.mjs" collect "$@"
    ;;
