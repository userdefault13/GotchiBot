}

cmd_mode() {
  local sub="${1:-get}"
  shift || true
  case "$sub" in
    gotchi|sandbox|sub|sub-agent|verse|plan|build|ask|project)
      case "$sub" in sub|sub-agent|project) sub=sandbox ;; esac
      exec node "$ROOT/scripts/agent-mode.mjs" set "$sub" "$@"
      ;;
    cycle)
      exec node "$ROOT/scripts/agent-mode.mjs" cycle "$@"
      ;;
    get|status|"")
      exec node "$ROOT/scripts/agent-mode.mjs" get "$@"
      ;;
    *)
      echo "unknown mode: $sub (use gotchi|sandbox|verse|plan|build|ask)" >&2
      echo "  /project is a Sandbox modal, not a Tab agent" >&2
      exit 2
      ;;
  esac
}

