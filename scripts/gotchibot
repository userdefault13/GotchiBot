#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SESSIONS="$ROOT/sessions"
DISPATCH="$ROOT/scripts/opencode-dispatch.sh"
PIN="$SESSIONS/.pin"
mkdir -p "$SESSIONS"

usage() {
  cat >&2 <<'EOF'
gotchibot — GotchiBot orchestrator CLI

  gotchibot tmux                  open orchestrator (sidebar | opencode | avatar)
  gotchibot sidebar               toggle file explorer (mc) sidebar
  gotchibot new [--model t] "P"   spawn a sub-agent (t: nim|pro|local|<id>)
  gotchibot ask [--model t] "…"   natural-language task → auto-route + spawn
  gotchibot list                  session table
  gotchibot status <id>...        one session's state
  gotchibot wait [<id>...]        block until sessions finish
  gotchibot output <id>           print a session deliverable
  gotchibot requests              pending skill requests
  gotchibot init                first-run setup: connect wallet, sim-mint cartridge
  gotchibot connect            open browser wallet-connect (MetaMask)
  gotchibot wallet             show connected wallet address
  gotchibot roster --wallet    list your real on-chain gotchis
  gotchibot avatar <agentId>      pin an agent to the avatar pane
  gotchibot handoff [oldId]       build HANDOFF.md and seed a new session
  gotchibot checkpoint <id> <label>   push a milestone to the cartridge
  gotchibot identity ensure|mint|roster   cartridge identity ops
EOF
  exit 2
}

cmd_tmux() {
  command -v tmux >/dev/null || { echo "tmux missing: brew install tmux" >&2; exit 1; }
  # Do not wrap in abra — tmux attach needs a real TTY (abra breaks attach).
  # API keys are injected inside chat/sub-agent panes when needed.
  local sess="${GOTCHIBOT_TMUX_SESSION:-gotchibot}"
  local min_right="${GOTCHIBOT_TMUX_RIGHT_WIDTH:-42}"
  local layout="$ROOT/scripts/orchestrator-layout.sh"

  if tmux has-session -t "$sess" 2>/dev/null; then
    "$layout" refresh
    exec tmux attach -t "$sess" \; select-pane -t work.1 \; run-shell "'$layout' fit"
  fi
  tmux new-session -d -s "$sess" -n work
  "$layout" refresh
  exec tmux attach -t "$sess" \; select-pane -t work.1 \; run-shell "'$layout' fit"
}

cmd_avatar() {
  printf '%s\n' "$1" > "$PIN"
  rm -f "$SESSIONS/.avatars/$1.svg"
  echo "pinned avatar: $1"
}

cmd_handoff() {
  node "$ROOT/scripts/handoff.mjs" "$@"
}

cmd_ask() {
  local model="" prompt="" tier
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      *) prompt="$1"; shift ;;
    esac
  done
  [ -n "$prompt" ] || usage

  if [ -z "$model" ]; then
    tier="$(node "$ROOT/scripts/prompt-route.mjs" "$prompt" 2>/dev/null || echo nim)"
    model="$tier"
  fi

  local ctx="$prompt"
  if [ -f "$SESSIONS/HANDOFF.md" ]; then
    ctx="$(cat <<EOF
Context from prior work (HANDOFF.md):
$(head -c 4000 "$SESSIONS/HANDOFF.md")

---
User task:
$prompt
EOF
)"
  fi

  echo "→ spawning ($model): $prompt"
  local id
  id="$("$DISPATCH" new --model "$model" "$ctx")"
  echo "  session: $id  (gotchibot output $id)"
  # shellcheck source=scripts/progress-bar.sh
  source "$ROOT/scripts/progress-bar.sh"
  (
    st="$(progress_wait_session "$id" "$ROOT")"
    if [ "$st" = failed ] && [ -f "$SESSIONS/$id/output.log" ]; then
      echo "  failed: $(grep -iE 'error|unauthorized|missing' "$SESSIONS/$id/output.log" | tail -1 | sed 's/\x1b\[[0-9;]*m//g')"
    elif [ "$st" = done ] && [ -s "$SESSIONS/$id/output.md" ]; then
      head -c 400 "$SESSIONS/$id/output.md" | sed 's/^/  /'
    fi
  ) &
}

cmd_checkpoint() {
  [ $# -ge 2 ] || usage
  GOTCHIBOT_CHECKPOINT_SESSION="$1" GOTCHIBOT_CHECKPOINT_LABEL="$2" \
    node "$ROOT/scripts/identity.mjs" checkpoint
}

cmd_wallet() {
  local f="$SESSIONS/.wallet.json"
  [ -f "$f" ] || { echo "no wallet connected — run: gotchibot connect" >&2; exit 1; }
  python3 -c "import json;print(json.load(open('$f'))['address'])"
}

cmd_roster() {
  exec node "$ROOT/scripts/wallet-roster.mjs" "$@"
}

cmd_identity() {
  node "$ROOT/scripts/identity.mjs" "$@"
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  tmux) cmd_tmux ;;
  new) "$DISPATCH" new "$@" ;;
  list) exec "$DISPATCH" list ;;
  status) exec "$DISPATCH" status "$@" ;;
  wait) exec "$DISPATCH" wait "$@" ;;
  output) exec "$DISPATCH" output "$@" ;;
  requests) exec "$DISPATCH" requests ;;
  avatar) [ $# -eq 1 ] || usage; cmd_avatar "$1" ;;
  init) exec node "$ROOT/scripts/init.mjs" ;;
  connect) exec node "$ROOT/scripts/wallet-connect.mjs" ;;
  wallet) cmd_wallet ;;
  roster) cmd_roster "$@" ;;
  handoff) cmd_handoff "$@" ;;
  ask) cmd_ask "$@" ;;
  checkpoint) cmd_checkpoint "$@" ;;
  identity) cmd_identity "$@" ;;
  sidebar) exec "$ROOT/scripts/orchestrator-layout.sh" sidebar ;;
  *) usage ;;
esac
