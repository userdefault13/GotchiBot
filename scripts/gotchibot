  abra_or_node "$ROOT/scripts/wisp.mjs" "$@"
}

[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in
  tmux) cmd_tmux ;;
  chat) cmd_chat "$@" ;;
  spawn) cmd_spawn "$@" ;;
  sandbox)
    exec node "$ROOT/scripts/sandbox.mjs" "$@"
    ;;
  new) "$DISPATCH" new "$@" ;;
