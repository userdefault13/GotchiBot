#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${HOME}/.openclaw/bin:${PATH}"
# shellcheck source=/dev/null
[ -f "$ROOT/scripts/openclaw-gateway-env.sh" ] && source "$ROOT/scripts/openclaw-gateway-env.sh"
SESSIONS="$ROOT/sessions"
DISPATCH="$ROOT/scripts/opencode-dispatch.sh"
PIN="$SESSIONS/.pin"
mkdir -p "$SESSIONS"

usage() {
  cat >&2 <<'EOF'
gotchibot — GotchiBot orchestrator CLI

  gotchibot tmux                  open orchestrator (sidebar | chat | avatar)
  gotchibot chat                    chat pane runtime (OpenCode)
  gotchibot sidebar               toggle medium file explorer (mc)
                                  # in mc: F2 → Add to Gotchi chat (or press a)
  gotchibot files-max             Files full-bleed / chat→bar (Mac: Ctrl-b f)
  gotchibot avatar                show the avatar pane (Ctrl+G or F6)
  gotchibot avatar-max            Avatar full-bleed / chat→bar (Mac: Ctrl-b a)
  gotchibot spawn [--host auto|imac|local] [--sandbox] [--model t] "P"   spawn (Tailscale iMac when auto/imac)
                                  # --sandbox = Docker box; hero must be available; never auto-mint
  gotchibot sandbox up|exec|status|promote|rm|ensure-image   Docker sandbox ops
  gotchibot new [--model t] "P"   spawn a sub-agent
  gotchibot ask [--model t] "…"   natural-language task → auto-route + spawn
  gotchibot multitask run "…"   parallel sub-agents (Cursor-style /multitask)
  gotchibot mode [gotchi|sandbox|verse|plan|build|ask|cycle] [--restart]  OpenCode agent
  gotchibot wisp status|mint|env [--json]   Wisp soul MCP (Gotchi Closet; key not printed)
  gotchibot wisp-proxy [--check]            OpenAI proxy for /model wisp/gotchi (:45682)
                                  # note: mode sandbox = pink TUI playground; gotchibot sandbox = Docker
  gotchibot marketplace               native Marketplace TUI (CDN → local fallback)
  gotchibot templates …               marketplace packs (list|menu|show|install|apply|equip|cdn)
  gotchibot pack-wearable …           nest/equip marketplace packs on cGotchi slot 15 (assignment label)
  gotchibot gotchi-mode [status|env|model|ensure] [--json]  OpenCode TUI → iMac orchestrator session
  gotchibot cursor run|resume|launch|context|list  Cursor CLI (orchestrator context)
  gotchibot codex run|resume|status  Codex CLI (alternate coding agent)
  gotchibot list                  session table
  gotchibot agents [--json]       cAavegotchis + MBP/iMac sessions (/list)
  gotchibot switch [n|id]         list agents, or switch avatar+direct chat (/switch)
  gotchibot focus <n|id>          pin avatar + SUB chat focus
  gotchibot cockpit               mint / avatar / Settings (/cockpit)
  gotchibot mint-cart --product abra|gotchibot|bundle [--tier t] [--pay usdc|ghst]
                                  # sealed Base Sepolia mint via MetaMask (or --quote)
  gotchibot kanban [--json] [--watch]   clawbot seats + tasks board (/kanban)
    gotchibot messaging [--text|--json|--channel <id>]   channel routing index (bot-inbox/passoff/meet/agentmail)
  gotchibot pkm-record …              notify kanban-manager (delegated|submitted|reviewed)
  gotchibot project-kanban …            sealed project + desk mini task boards
  gotchibot project-tickets …           agent request/claim/submit tickets (PKM owns lifecycle)
  gotchibot project-mailbox …           per-desk local mailboxes (inbox+sent) under project AgentMail
  gotchibot inbox send|list|read|archive|digest|unread|tui   internal bot mail (not AgentMail)
  gotchibot graph …                 graph-state init|get|set|next|stop|list (sessions/graph)
  gotchibot jev ask|smoke|models    TypeSafe Jev System One decisions (not chat)
  gotchibot meet start|open|invite|status|say|morning|colabo|end   persistent room (/meet); start/end = record
  gotchibot model-policy [show|pick|candidates|enforce]  working-models-only policy
  gotchibot tui-policy [show|enforce|apply]  Tab cycles in OpenCode TUI (no tmux steal)
  gotchibot layout-check [check|desk|meet]  verify tmux panes (non-destructive)
  gotchibot orch                  restore orchestrator focus (/orch)
  gotchibot openclaw sync|list|status|chat|install|point  OpenClaw fleet + CLI
  gotchibot delegate [--json] [hint]  pick next local/remote agent (/delegate)
  gotchibot hero-state set|sync|get   cAavegotchi agentStatus on cartridge sim
                                      # available|active|working|assigned|idle|watching
  gotchibot status <id>...        one session's state
  gotchibot wait [<id>...]        block until sessions finish
  gotchibot output <id>           print a session deliverable
  gotchibot export [<id>] [--out PATH] [--log]   save a session transcript as Markdown
                                  # asks where to save; ~/Downloads by default, remembers your last folder
  gotchibot requests              pending skill requests
  gotchibot init                first-run setup: connect wallet, sim-mint cartridge
  gotchibot onboard             Solo one-shot: wallet → register → init → doctor
  gotchibot setup               print Solo checklist (or run onboard above)
  gotchibot topology solo|fleet|status [--json]   Solo vs Fleet spawn host
  gotchibot doctor              env checklist (node/tmux/abra/topology/referral/wallet/infra/fleet probe)
  gotchibot login [--status]    restore the OpenCode Go credential (console key → auth.json) in a Terminal window
  gotchibot wsl [--check]       WSL2 install guide (Windows) or in-WSL readiness check
  gotchibot update [--check|--apply|--force]  check/install GotchiBot updates (CDN or git)
  gotchibot infra register|status   Solo install token (GOTCHIBOT_INFRA_TOKEN via abra)
  gotchibot chats push|pull|threads|snapshot|checkpoint-prompt|onchain|hook|verify
                                  BYO Hub chat sync + optional Sepolia checkpointSave
  gotchibot db wizard|local|atlas|none|status|pin-desk
                                  BYO Mongo (local Docker / Atlas / skip) → sessions/.mongo.json
  gotchibot hub enable <host>|pin|chat-store|arcade-status
                                  own Hub Tailscale pin → sessions/.hub.json (Arcade metadata)
  gotchibot hub install [--dry-run|--uninstall]   set up THIS computer as your Hub (gotchibot-api + Mongo + tailscale serve)
  gotchibot hub pair|desks|revoke <deskId>        on the Hub: pairing codes + paired desks
  gotchibot hub join <host> <code>                on a desk: pair with your Hub
  gotchibot api start|stop|status                 run gotchibot-api by hand (dev)
  gotchibot infra schedule status|install|uninstall|run-now  YFI 15-min supervisor LaunchAgent (run on the iMac)
  gotchibot desk-terminals status|open|close|use|install|uninstall [hero…] [--host imac|local]
                                  driven desks stay up; workers: use → tool → close (ephemeral)
  gotchibot infra-usage [--json]    operator: install-token usage report (Mongo / cost proxy)
  gotchibot aseprite check|export|init-tileset|init-sprite|script|info|svg-import|svg-export   Aseprite CLI (pixel art)
  gotchibot connect            open browser wallet-connect (MetaMask)
  gotchibot wallet             show connected wallet address
  gotchibot roster --wallet    list your real on-chain gotchis
  gotchibot avatar [agentId]      show avatar pane, or pin an agent
  gotchibot handoff [oldId]       build HANDOFF.md and seed a new session
  gotchibot passoff send <to> [--from …] [--note "…"] [--next "…"] [--dry-run]
                                  hand live work to another gotchi (packet + message)
  gotchibot passoff list|show|accept|resume|drop  the receiving side (/passoff)
  gotchibot wake status|list|run|install|uninstall [hero|role|--all] [--role <id>] [--json]
                                  common desk-wake (skill desk-wake; launchd on iMac;
                                  defer desks keep their own schedule CLIs)
  gotchibot pstack init|status|list|roles|brief|unit|ledger|decision
                                  pstack chief program store (skill: pstack; never spawns)
  gotchibot pstack dossier new|show|set|ready|list|fields|current
                                  pstack dossier SoT per program slug (wizard pane: work.1 center)
  gotchibot ralph start|status|cancel|list|bump
                                  ralph-loop store (skill: ralph; never spawns; hooks drive iterations)
  gotchibot add-dir <path>|list|remove <path>|clear
                                  extra workspace roots for write-guard (/add-dir)
  gotchibot claude-plugin [build|--check]  package .claude/ (hooks, commands, agents)
                                  as an installable plugin for the iMac
  gotchibot contexter save|latest|show|list|prune   carry key values, decisions and
                                  dead ends across a context window (skill: contexter)
  gotchibot cursor-layer check [--json]  assert Cursor desk layer (hooks, policy, skills)
  gotchibot checkpoint project [--clear] [<label>]  desk projects → cart (signed gameState; --clear on transfer)
  gotchibot checkpoint <id> <label>   push a milestone to the cartridge (+ projects)
  gotchibot identity ensure|mint|roster   cartridge identity ops
  gotchibot reset [--full] [--yes]      wipe gotchibot cartridge (new-user test)
  gotchibot onboarding              re-run welcome / sign-in gate
  gotchibot attach [--mini] [-c]      attach TUI to iMac orchestrator (opencode serve)
  gotchibot qr [--copy|--openlens]    iPhone connect: --copy = auth URL to clipboard; default = http QR
  gotchibot remote -- <cmd>         run command on iMac via Tailscale SSH (abra keys)
  gotchibot remote-sync               push wallet/identity/onboarding to iMac
  gotchibot remote-setup              print Tailscale + abra SSH setup checklist
  gotchibot remote-push               rsync GotchiBot tree to iMac (empty-git fix)
  gotchibot remote-openclaw [--http-only]  iMac OpenClaw: full deploy, or just enable /v1/chat/completions
  gotchibot remote-serve              start/restart iMac orchestrator opencode serve
  gotchibot comms run|dry-run|status  WBTC comms: Claude terminal on the iMac drafts, API publishes,
                                      Claude's reply printed verbatim (never Commsies / Cloudflare AI)
                                      extra args pass through: --range AarcadeGh-t:<before>..<after>, --repo X
  gotchibot comms schedule status|install  WBTC daily comms crontab on the iMac (23:50 America/Los_Angeles)
  gotchibot comms-cron-deploy         (alias of comms schedule install)
  gotchibot commsies-imac-deploy      (legacy) keep Commsies (:3002 + Ollama) alive on iMac — not used by comms
  gotchibot remote-status             probe Tailscale/SSH readiness (no secrets)
  gotchibot hub [status|roster|dashboard|monitor|restart-gateway|doctor|bridge-…]  Hub SOP + OC/bridge dashboard
  gotchibot hub roster [--all] [--live] [--json]  who is on which desk, and how
                                  many desks are on the tailnet
  gotchibot bridge|bridge-prompt [--host auto|network|imac|local] [--wait] "…"
                                  Desk→Hub Claude VS Code; reply on Desk
  gotchibot vscode-open|vscode-ensure [--check]  open/focus Hub VS Code on GotchiBot (code -r)
  gotchibot bridge-ensure|ensure-bridge [--json]  one-shot Hub Claude bridge recovery (receiver + bridge + restart)
  gotchibot claude-ask|claudemode-ask "…"  bridge ask sync (short; orch stays on big-pickle)
  gotchibot claude-submit "…"             async submit → {id,pending}; prefer for long Claude
  gotchibot claude-collect <id>           collect ready job after push-wake
  gotchibot claude-jobs [--status …]      list async Claude jobs
  gotchibot claude-pane-init [--check]    ensure Hub Claude proxy CLAUDE.md + @gotchibot-proxy agent
  gotchibot claudemode-proxy [--check]  optional OpenAI proxy for /model @claudemode (:45680)
  gotchibot tunnel status|restart     subgraph.aarcadeghst.com health + iMac cloudflared restart
  gotchibot menubar install|uninstall|preview|path|open  macOS menu bar ghost + agent count (SwiftBar)
  gotchibot mesh [ping] [--live] [--json]  agent count + status across MBP and iMac (Tailscale SSH)
  gotchibot trader [monitor|improve|news] [--json] [--host imac]  Gotchi-Trader desk
  gotchibot trader schedule status|install|uninstall|run-now  LINK 30-min cycle LaunchAgent (run on the iMac)
  gotchibot moltbook watch [--json] [--env-file <path>]  Moltbook watch desk — one cycle (queue only, no posting)
  gotchibot moltbook schedule status|install|uninstall|run-now  Moltbook 15-min watch LaunchAgent (run on the iMac)
  gotchibot moltbook reply [--run|--show] [--json]  draft replies for queued Moltbook items (dry-run default; drafts only, never posts)
  gotchibot link-cube intake|design|confirm|summon|resummon|bind|status
                                  Prof. Link-Cube NPC (not mintable): summon (portal) or resummon
                                  an existing cAavegotchi — intake → design → confirm → wire
                                  role/playbook/SOUL/IDENTITY + fleet sync. Never auto-mints;
                                  confirm needs --yes / GOTCHIBOT_AUTO_APPROVE=1 (/link-cube).
                                  Aliases: hatch→summon, rehatch→resummon. Never mint the professor.
                                  Marketplace: gotchibot templates apply <id> --hero <hero> [--yes]
  gotchibot model [pick|list|resolve] [--json] [--probe]  pick a free, listed model
  gotchibot aseprite …                Aseprite batch export/init (see skill aseprite-tool)
  gotchibot pdf check|info|search|read-pages|tables|chunks|render  PDF via PyMuPDF
  gotchibot marketplace|templates menu   native Marketplace (pulls templates.aarcadeghst.com)
  gotchibot templates list|show|pack|install|apply|cdn   bot-template marketplace (Prof. Link-Cube)
                                  # list --remote · cdn deploy|status → templates.aarcadeghst.com
  gotchibot tts on|off|status|test|speed|warm|stop-daemon  voice (MeloTTS EN-AU / edge-tts / say)
EOF
  exit 2
}

# Best-effort OpenClaw fleet sync from cartridge heroes (non-fatal; runs before tmux).
sync_openclaw_fleet() {
  command -v node >/dev/null 2>&1 || return 0
  if [ -n "${SSH_PRIVATE_KEY:-}" ] && [ -n "${REMOTE_HOST:-}" ]; then
    node "$ROOT/scripts/openclaw-fleet.mjs" sync --quiet 2>/dev/null || true
  elif command -v abra >/dev/null 2>&1; then
    abra run gotchibot -- node "$ROOT/scripts/openclaw-fleet.mjs" sync --quiet 2>/dev/null || true
  else
    node "$ROOT/scripts/openclaw-fleet.mjs" sync --quiet 2>/dev/null || true
  fi
}


cmd_chat() {
  local want="${1:-opencode}"
  local file="$SESSIONS/.chat-runtime"
  local current="opencode"
  local sess_name="${GOTCHIBOT_TMUX_SESSION:-gotchibot}"
  sess_name="${sess_name#=}"
  local sess="$sess_name"
  local layout="$ROOT/scripts/orchestrator-layout.sh"
  [ -f "$file" ] && current="$(tr -d "[:space:]" < "$file")"
  case "$want" in
    status)
      echo "chat runtime: $current"
      if [ -f "$SESSIONS/.layout-mode" ]; then
        echo "layout: $(tr -d '[:space:]' < "$SESSIONS/.layout-mode")"
      fi
      ;;
    opencode|restore|desk|"")
      mkdir -p "$SESSIONS"
      printf 'opencode\n' > "$file"
      echo "chat runtime → opencode"
      if [ -n "${TMUX:-}" ] && tmux has-session -t "=$sess_name" 2>/dev/null; then
        # Always repair via leave-meet-gallery (idempotent). Gating on
        # meet-gallery only left a blank center when mode was already normal.
        tmux run-shell -b -t "$sess:work.0" \
          "cd \"$ROOT\" && GOTCHIBOT_LAYOUT_SAFE=1 GOTCHIBOT_TMUX_SESSION=\"$sess_name\" \"$layout\" leave-meet-gallery" \
          2>/dev/null || true
      else
        echo "respawn chat: ./scripts/gotchibot tmux"
      fi
      ;;
    *)
      echo "usage: gotchibot chat [opencode|restore|status]" >&2
      exit 2
      ;;
  esac
}

maybe_update_check() {
  command -v node >/dev/null 2>&1 || return 0
  node "$ROOT/scripts/update-check.mjs" --launch 2>/dev/null || true
}

cmd_tmux() {
  if ! command -v tmux >/dev/null 2>&1; then
    node "$ROOT/scripts/wsl-setup.mjs" 2>/dev/null || true
    echo "tmux missing — see: gotchibot wsl" >&2
    exit 1
  fi
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "gotchibot tmux needs an interactive terminal (not piped/background)." >&2
    echo "  Run from Terminal/iTerm:  GotchiBot   or   ./scripts/gotchibot tmux" >&2
    exit 1
  fi
  # shellcheck source=scripts/progress-bar.sh
  source "$ROOT/scripts/progress-bar.sh"
  # Gotchi pink while the shell is blank before tmux attach.
  PROGRESS_FG=$'\033[38;5;213m'
  progress_pulse "GotchiBot · starting…" 0
  maybe_update_check
  progress_pulse "GotchiBot · syncing fleet…" 4
  # Do not wrap in abra — tmux attach needs a real TTY (abra breaks attach).
  # API keys are injected inside chat/sub-agent panes when needed.
  sync_openclaw_fleet
  local sess_name="${GOTCHIBOT_TMUX_SESSION:-gotchibot}"
  sess_name="${sess_name#=}"
  local sess="$sess_name"
  local layout="$ROOT/scripts/orchestrator-layout.sh"
  # Launcher must run layout in-process — if TMUX_PANE is set (nested/relaunch from
  # chat/avatar), orchestrator-layout.sh would tmux run-shell + exit 0 and drop us here.
  export GOTCHIBOT_LAYOUT_SAFE=1
  export GOTCHIBOT_TMUX_SESSION="$sess_name"

  # Exact has-session (=name) so gotchibot-hubmon is not mistaken for gotchibot.
  # Bare name for attach/layout targets — set-option rejects -t =name on tmux 3.7c.
  if tmux has-session -t "=$sess_name" 2>/dev/null; then
    progress_pulse "GotchiBot · refreshing desk…" 8
    # Always reattach into normal desk + cockpit (peels meet / pstack / max modes).
    if ! "$layout" enter-cockpit; then
      progress_fail "GotchiBot · cockpit boot failed"
      echo "orchestrator enter-cockpit failed — try: tmux kill-session -t '=$sess_name' && ./scripts/gotchibot tmux" >&2
      exit 1
    fi
    progress_pulse "GotchiBot · attaching…" 12
    progress_end
    exec tmux attach -t "=$sess_name" \; select-pane -t "$sess:work.1" \; run-shell "'$layout' fit-quiet"
  fi
  progress_pulse "GotchiBot · building desk…" 8
  tmux new-session -d -s "$sess_name" -n work
  if ! "$layout" ensure; then
    progress_fail "GotchiBot · layout ensure failed"
    echo "orchestrator layout ensure failed — try: tmux kill-session -t '=$sess_name' && ./scripts/gotchibot tmux" >&2
    exit 1
  fi
  # Orch calls poke-avatar — must run after 3-pane layout (USR1 on work.2 before
  # that hits the lone boot shell and kills the tmux server).
  node "$ROOT/scripts/agent-focus.mjs" orch >/dev/null 2>&1 || true
  progress_pulse "GotchiBot · attaching…" 14
  progress_end
  exec tmux attach -t "=$sess_name" \; select-pane -t "$sess:work.1" \; run-shell "'$layout' fit-quiet"
}

cmd_avatar() {
  printf '%s\n' "$1" > "$PIN"
  rm -f "$SESSIONS/.avatars/$1.svg"
  node "$ROOT/scripts/gotchi-svg.mjs" --force "$1" >/dev/null 2>&1 || true
  if [ -n "${TMUX:-}" ]; then
    "$ROOT/scripts/poke-avatar.sh" >/dev/null 2>&1 || true
  fi
  echo "pinned avatar: $1"
}

cmd_handoff() {
  node "$ROOT/scripts/handoff.mjs" "$@"
}

cmd_spawn() {
  # Default host=auto → iMac over Tailscale when SSH is up (gotchi mode).
  exec node "$ROOT/scripts/gotchi-orchestrate.mjs" spawn "$@"
}

cmd_ask() {
  local model="" prompt="" tier
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      *) prompt="$1"; shift ;;
    esac
  done
  [ -n "$prompt" ] || usage

  if [ -z "$model" ]; then
    tier="$(node "$ROOT/scripts/prompt-route.mjs" "$prompt" 2>/dev/null || echo auto)"
    model="$tier"
  fi

  local ctx="$prompt"
  if [ -f "$SESSIONS/HANDOFF.md" ]; then
    ctx="$(cat <<EOF
Context from prior work (HANDOFF.md):
$(head -c 4000 "$SESSIONS/HANDOFF.md")

---
User task:
$prompt
EOF
)"
  fi

  echo "→ spawning ($model): $prompt"
  local id
  id="$(node "$ROOT/scripts/gotchi-orchestrate.mjs" spawn --model "$model" "$ctx")"
  echo "  session: $id  (gotchibot output $id)"
  # shellcheck source=scripts/progress-bar.sh
  source "$ROOT/scripts/progress-bar.sh"
  (
    st="$(progress_wait_session "$id" "$ROOT")"
    if [ "$st" = failed ] && [ -f "$SESSIONS/$id/output.log" ]; then
      echo "  failed: $(grep -iE 'error|unauthorized|missing' "$SESSIONS/$id/output.log" | tail -1 | sed 's/\x1b\[[0-9;]*m//g')"
    elif [ "$st" = done ] && [ -s "$SESSIONS/$id/output.md" ]; then
      head -c 400 "$SESSIONS/$id/output.md" | sed 's/^/  /'
    fi
  ) &
}

cmd_checkpoint() {
  # gotchibot checkpoint chat-sync | chat   — Arcade snap + optional Sepolia
  # gotchibot checkpoint project [--clear] [<label>]  — desk projects → cart gameState
  # gotchibot checkpoint <sessionId> <label> — session milestone (+ projects)
  if [ "${1:-}" = "chat-sync" ] || [ "${1:-}" = "chat" ]; then
    shift
    exec node "$ROOT/scripts/chat-sync.mjs" checkpoint-prompt "$@"
  fi
  if [ "${1:-}" = "project" ]; then
    shift
    local clear=0 label="project"
    while [ $# -gt 0 ]; do
      case "$1" in
        --clear) clear=1; shift ;;
        *) label="$1"; shift ;;
      esac
    done
    if [ "$clear" = 1 ]; then
      GOTCHIBOT_CHECKPOINT_CLEAR_PROJECTS=1 \
      GOTCHIBOT_CHECKPOINT_CLEAR_REASON=transfer \
      GOTCHIBOT_CHECKPOINT_LABEL="${label:-project-cleared}" \
        node "$ROOT/scripts/identity.mjs" checkpoint
    else
      GOTCHIBOT_CHECKPOINT_LABEL="$label" \
        node "$ROOT/scripts/identity.mjs" checkpoint
    fi
    return
  fi
  [ $# -ge 2 ] || usage
  GOTCHIBOT_CHECKPOINT_SESSION="$1" GOTCHIBOT_CHECKPOINT_LABEL="$2" \
    node "$ROOT/scripts/identity.mjs" checkpoint
}

cmd_wallet() {
  local f="$SESSIONS/.wallet.json"
  [ -f "$f" ] || { echo "no wallet connected — run: gotchibot connect" >&2; exit 1; }
  python3 -c "import json;print(json.load(open('$f'))['address'])"
}

