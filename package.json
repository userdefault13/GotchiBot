{
  "name": "@userdefault/gotchibot",
  "version": "0.2.1",
  "description": "GotchiBot \u2014 Aavegotchi agent orchestrator (OpenClaw / OpenCode; macOS, Linux, Windows/WSL)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/userdefault13/GotchiBot.git"
  },
  "homepage": "https://www.aarcadeghst.com",
  "bugs": {
    "url": "https://github.com/userdefault13/GotchiBot/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "gotchibot": "scripts/gotchibot"
  },
  "files": [
    "scripts/",
    "config/",
    "skills/",
    "assets/",
    "docs/",
    "mcp-servers/",
    "patches/",
    "docker/",
    "AGENTS.md",
    "SOUL.md",
    "ORCHESTRATOR.md",
    "IDENTITY_SYSTEM.md",
    "IDENTITY.md",
    "opencode.json",
    "LICENSE",
    "COMMERCIAL.md",
    "README.md",
    "!.opencode/**",
    "!.cursor/**",
    "!config/openclaw.fleet.generated.json5",
    "!config/openclaw.fleet.list.json5",
    "!config/openclaw.install.json5",
    "!config/hub-bridge.json",
    "!scripts/remote-spawn-discord.mjs"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/update-check.mjs --check"
  },
  "keywords": [
    "aavegotchi",
    "gotchibot",
    "openclaw",
    "opencode",
    "agents"
  ]
}
